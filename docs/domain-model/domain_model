classDiagram
direction TB

class EVChargingNetworkApp {
  -EVChargingNetwork network
  -LocationManager locationManager
  -CustomerManager customerManager
  -ChargingSessionManager chargingSessionManager
  +main(String[] args)$ void
}
class LocationManager {
  -EVChargingNetwork network
  +createLocation(String name, String address) Location
  +getAllLocations() List~Location~
  +updateLocation(Location l, String name, String address) void
  +removeLocation(Location l) void
  +addChargingPoint(Location l, ChargingMode mode) ChargingPoint
  +updateOperatingStatus(ChargingPoint cp, OperatingStatus s) void
  +removeChargingPoint(Location l, ChargingPoint cp) void
  +setPriceList(Location l, PriceList p) void
  +getNetworkStatus() String
}
class CustomerManager {
  -EVChargingNetwork network
  +registerCustomer(String name, String email) Customer
  +getCustomers() List~Customer~
  +updateCustomer(Customer c, String name, String email) void
  +topUp(Customer c, BigDecimal amount) TopUp
  +getBalance(Customer c) BigDecimal
  +getLedger(Customer c) String
}
class ChargingSessionManager {
  -EVChargingNetwork network
  +startChargingSession(Customer c, Location l, ChargingPoint cp) ChargingSession
  +endChargingSession(ChargingSession s, double kwh, int minutes) void
}

class Owner {
  -String name
}
class EVChargingNetwork {
  -String name
  -Owner owner
  -List~Location~ locations
  -List~Customer~ customers
  +addLocation(Location location) void
  +removeLocation(Location location) void
  +getLocations() List~Location~
  +addCustomer(Customer customer) void
  +getCustomers() List~Customer~
}
class Location {
  -String name
  -String address
  -List~ChargingPoint~ chargingPoints
  -PriceList priceList
  +addChargingPoint(ChargingPoint cp) void
  +removeChargingPoint(ChargingPoint cp) void
  +getChargingPoints() List~ChargingPoint~
  +setPriceList(PriceList priceList) void
  +getPriceList() PriceList
}
class PriceList {
  -BigDecimal energyPriceAcPerKwh
  -BigDecimal energyPriceDcPerKwh
  -BigDecimal parkingPriceAcPerMinute
  -BigDecimal parkingPriceDcPerMinute
  +getEnergyPrice(ChargingMode mode) BigDecimal
  +getParkingPrice(ChargingMode mode) BigDecimal
}
class ChargingPoint {
  -String chargingPointId
  -ChargingMode chargingMode
  -OperatingStatus operatingStatus
  +setOperatingStatus(OperatingStatus status) void
  +isAvailable() boolean
}
class ChargingMode {
  <<enumeration>>
  AC
  DC
}
class OperatingStatus {
  <<enumeration>>
  AVAILABLE
  OCCUPIED
  OUT_OF_ORDER
}

class Customer {
  -String customerId
  -String name
  -String email
  -CustomerAccount customerAccount
  +update(String name, String email) void
  +getCustomerAccount() CustomerAccount
}
class CustomerAccount {
  -BigDecimal balance
  -Ledger ledger
  +topUp(BigDecimal amount) TopUp
  +payChargingCost(ChargingSession session) void
  +getBalance() BigDecimal
  +getLedger() Ledger
}
class Ledger {
  -List~LedgerEntry~ entries
  +addEntry(LedgerEntry entry) void
  +getEntries() List~LedgerEntry~
}
class LedgerEntry {
  <<abstract>>
  -LocalDateTime timestamp
  +getAmount()* BigDecimal
}
class TopUp {
  -BigDecimal amount
  +getAmount() BigDecimal
}
class ChargingSession {
  -LocalDateTime endTimestamp
  -BigDecimal energyPricePerKwh
  -BigDecimal parkingPricePerMinute
  -double chargedEnergyKwh
  -int chargingDurationMinutes
  +end(double kwh, int minutes) void
  +getChargingCost() BigDecimal
  +getAmount() BigDecimal
}

EVChargingNetworkApp "1" *-- "1" LocationManager
EVChargingNetworkApp "1" *-- "1" CustomerManager
EVChargingNetworkApp "1" *-- "1" ChargingSessionManager
EVChargingNetworkApp --> "1" EVChargingNetwork
LocationManager --> "1" EVChargingNetwork
CustomerManager --> "1" EVChargingNetwork
ChargingSessionManager --> "1" EVChargingNetwork

EVChargingNetwork --> "1" Owner : operated by
EVChargingNetwork "1" *-- "0..*" Location
EVChargingNetwork "1" o-- "0..*" Customer
Location "1" *-- "1..*" ChargingPoint
Location "1" *-- "1" PriceList
ChargingPoint --> "1" ChargingMode
ChargingPoint --> "1" OperatingStatus

Customer "1" *-- "1" CustomerAccount
CustomerAccount "1" *-- "1" Ledger
Ledger "1" *-- "0..*" LedgerEntry
LedgerEntry <|-- TopUp
LedgerEntry <|-- ChargingSession
ChargingSession "0..*" --> "1" ChargingPoint : at
ChargingSession "0..*" --> "1" Location : in